# .env.local.example — deploy-target pin (ADR-018).
#
#   cp .env.local.example .env.local   # then edit
#
# .env.local is REQUIRED for every deploy-touching command (cdk deploy/diff,
# npm run build:images, npm run app:create). Those commands verify that the
# ambient AWS credentials resolve to LCA_DEPLOY_ACCOUNT and refuse on mismatch,
# so a shell pointed at the wrong account can never deploy here.
# .env.local is gitignored — never commit it.

# Target AWS account (12 digits) — REQUIRED
LCA_DEPLOY_ACCOUNT=123456789012

# Target region — REQUIRED (any --region/-c region flag must match, or be omitted)
LCA_DEPLOY_REGION=us-west-2

# AWS profile to use when the shell doesn't set one — OPTIONAL
# AWS_PROFILE=my-deploy-profile
