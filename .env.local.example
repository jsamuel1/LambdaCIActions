# .env.local.example — deploy-target pin (ADR-018).
#
#   cp .env.local.example .env.local   # then edit
#
# .env.local is REQUIRED for every deploy-touching command (cdk deploy/diff,
# npm run build:images, npm run app:create). Those commands verify that the
# ambient AWS credentials resolve to LCA_DEPLOY_ACCOUNT and refuse on mismatch,
# so a shell pointed at the wrong account can never deploy here.
# .env.local is gitignored — never commit it.

# Target AWS account (12 digits) — REQUIRED
LCA_DEPLOY_ACCOUNT=123456789012

# Target region — REQUIRED (any --region/-c region flag must match, or be omitted)
LCA_DEPLOY_REGION=us-west-2

# AWS profile to use when the shell doesn't set one — OPTIONAL
# AWS_PROFILE=my-deploy-profile

# ---------------------------------------------------------------------------
# Console vanity domain (ADR-036) — OPTIONAL
#
# Set these to serve the console on a stable hostname instead of CloudFront's
# generated *.cloudfront.net name. This also removes the two-pass
# `-c publicOrigin=...` deploy (docs/DEPLOY-M4.md): the origin becomes known
# before the distribution exists.
#
# Leave them ALL unset to deploy on the raw CloudFront domain — required if this
# account owns no Route53 public zone. Setting only some of them is an error
# (a partial config would deploy a distribution with no alias while the API
# advertised the vanity origin, breaking login).
#
# Hostname scheme: prod → lambdaciactions.<zone>,  other envs → <env>.lambdaciactions.<zone>
#
# Route53 PUBLIC hosted zone id — bare id, NOT the `/hostedzone/...` path the API returns
# LCA_CONSOLE_HOSTED_ZONE_ID=Z01234567ABCDEFGHIJK
#
# Apex of that zone
# LCA_CONSOLE_ZONE_NAME=example.com
#
# Override the derived hostname entirely (must still be inside the zone above) — OPTIONAL
# LCA_CONSOLE_DOMAIN=console.example.com
#
# NOTE: the ACM certificate is always issued in us-east-1 (CloudFront's only accepted
# region), regardless of LCA_DEPLOY_REGION. That is handled by LCA-Cert-<env> — no
# extra config needed.
